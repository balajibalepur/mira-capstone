# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Rotate any key that is ever pasted into a screenshot or a chat.

# ---- LLM ----------------------------------------------------------------
# gpt-4o-mini is the Playbook's recommended default: cheap and adequate for
# extraction, classification and structured generation.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Observability ------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Optional -----------------------------------------------------------
# Trello integration is optional in the brief and worth no marks. Left unset.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
